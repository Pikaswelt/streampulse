# StreamPulse Configuration

# -------------------------------------------------------------
# 1. LLM API Keys (Pick one: Gemini, Groq, OpenAI, or Ollama)
# -------------------------------------------------------------
# Gemini (Recommended: ultra-fast, cheap / free-tier friendly)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq (Ultra-fast open models like Llama 3)
GROQ_API_KEY=your_groq_api_key_here

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# Local Ollama (leave keys blank, specify URL if custom)
# LLM_BASE_URL=http://localhost:11434/v1

# -------------------------------------------------------------
# 2. X / Twitter API v2 Credentials (Optional if using 1-Click Feed)
# -------------------------------------------------------------
TWITTER_CONSUMER_KEY=your_consumer_key
TWITTER_CONSUMER_SECRET=your_consumer_secret
TWITTER_ACCESS_TOKEN=your_access_token
TWITTER_ACCESS_TOKEN_SECRET=your_access_token_secret
TWITTER_BEARER_TOKEN=your_bearer_token

# -------------------------------------------------------------
# 3. Webhooks (Optional: Discord / Slack alerts)
# -------------------------------------------------------------
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# -------------------------------------------------------------
# 4. Stream Defaults
# -------------------------------------------------------------
DEFAULT_INTERVAL=180
WHISPER_MODEL=base
